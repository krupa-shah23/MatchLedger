{
  "name": "matchledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest-integration.config.ts",
    "test:flake": "node scripts/flake-gate.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:no-placeholders": "node scripts/check-no-placeholders.mjs",
    "bench": "npm --workspace @matchledger/benchmarks run bench",
    "chaos:pipeline": "node scripts/chaos-pipeline.mjs",
    "test:mutations": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
