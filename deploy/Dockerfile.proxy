FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS web-build
WORKDIR /app
ARG VITE_PROFILE=prod
ENV VITE_PROFILE=${VITE_PROFILE}
COPY . .
RUN npm ci --prefer-offline && npm run build --workspace @matchledger/web

FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
COPY --from=web-build /app/web/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
