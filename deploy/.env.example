# Hostname only (no scheme or path). Caddy obtains and renews TLS certificates.
PUBLIC_ORIGIN=example.com

# Set both with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=

APP_IMAGE_TAG=
POSTGRES_USER=matchledger
POSTGRES_DB=matchledger
JWT_TTL_SECONDS=900
SESSION_MAX_SECONDS=28800
PROFILE=demo
PRICE_DECIMALS=2
RATE_LIMIT_ORDERS_PER_SEC=10
RATE_LIMIT_BURST=20
PROJECTOR_POLL_MS=200
PROJECTOR_CHUNK=1000
PORT=3000
METRICS_PORT=3001
METRICS_HOST=0.0.0.0
TRANSPORT=kafka
KAFKA_BROKERS=kafka:9092
SHARD_PARTITIONS=4
HEARTBEAT_MS=5000
QUEUE_CAPACITY=1000
MAX_BATCH=100
SHUTDOWN_GRACE_MS=30000
SEED_DEMO=1
PROMETHEUS_URL=http://prometheus:9090
SIMULATOR_RATE_CAP=10
SIMULATOR_TICKS_PER_SEC=10
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB
GRAFANA_ANONYMOUS_ENABLED=true
