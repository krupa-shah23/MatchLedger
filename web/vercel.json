{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://matchledger-2.onrender.com/:path*" },
    { "source": "/ws", "destination": "https://matchledger-2.onrender.com/ws" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
